{
  "manifest_version": 3,
  "name": "Colonist Kaynak Takibi",
  "description": "colonist.io oyun log'unu okuyarak rakiplerin elindeki kaynakları canlı takip eder.",
  "version": "1.2.0",
  "content_scripts": [
    {
      "matches": ["https://colonist.io/*", "https://*.colonist.io/*"],
      "js": ["src/loader.js"],
      "css": ["styles/overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/*"],
      "matches": ["https://colonist.io/*", "https://*.colonist.io/*"]
    }
  ]
}
